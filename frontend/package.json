{
  "name": "findraco-frontend",
  "private": true,
  "version": "1.0.0-beta.17",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "tsc && vite build --mode development",
    "build:prod": "tsc && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "cd .. && husky frontend/.husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "node scripts/check-siblings.ts && vitest run --project=unit --project=tooling --project=storybook && vitest run --project=critical --coverage",
    "test:coverage": "vitest run --project=critical --coverage",
    "test:watch": "vitest --project=unit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.0.1",
    "@tailwindcss/vite": "^4.1.3",
    "@tanstack/react-query": "^5.72.1",
    "@tanstack/react-query-devtools": "^5.72.1",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-router-dom": "^7.6.1",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.3",
    "tw-animate-css": "^1.2.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@eslint/js": "^9.21.0",
    "@storybook/addon-a11y": "^9.1.5",
    "@storybook/addon-docs": "^9.1.5",
    "@storybook/addon-vitest": "^9.1.5",
    "@storybook/react-vite": "^9.1.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/estree": "1.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^9.1.5",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "playwright": "^1.55.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "storybook": "^9.1.5",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings=0"
  }
}
