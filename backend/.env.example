SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:PORT/DATABASE_NAME?ssl=true&sslmode=require
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

JWT_SECRET_KEY=generate_with__openssl_rand_-base64_64

# Optional — defaults to 3000
# SERVER_PORT=3000

# Optional — access token lifetime, defaults to 900000 (15 min)
# JWT_EXPIRATION_MS=900000

# Optional — defaults to true (session cookie sent over HTTPS only). Set false only if a
# browser refuses Secure cookies on plain-HTTP localhost during development.
# SESSION_COOKIE_SECURE=true

# Password recovery email. All optional: without SMTP_HOST the reset link is logged
# instead of emailed (dev needs no SMTP). APP_URL is the SPA base used in the link.
APP_URL=http://localhost:5173
# Local Mailpit (UI at http://localhost:8025):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# Gmail with an app password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=gmail-app-password
# SMTP_FROM=you@gmail.com
