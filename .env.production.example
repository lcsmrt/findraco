# Production stack variables. Set the real values in the Portainer stack editor —
# never commit them. Copy to .env for a local `docker compose up`.

# The API container runs with host networking on the same VPS as PostgreSQL, so
# localhost works and TLS is unnecessary. Reach for the public IP + sslmode=require
# only when the database lives somewhere else.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finsight
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# openssl rand -base64 64
JWT_SECRET_KEY=

# Kept for direct hits on port 3000 (Swagger, curl). The browser never triggers
# CORS: the SPA calls /api on its own origin and nginx proxies it. Must be set —
# the API fails to start without it.
ALLOWED_ORIGINS=http://72.60.1.97:5000

# Host port where nginx (SPA + /api proxy) is exposed. The whole app lives here.
WEB_PORT=5000

# Frontend build-time API URL.
# In the nginx-served production build this is usually unset so the client falls
# back to same-origin /api/findraco.
VITE_FINDRACO_API_URL=
